# Server-only local values, never copied into client/.env or a VITE_* variable.
N8N_API_BASE_URL=https://n8n.example.invalid
N8N_BASIC_AUTH_USER=replace-with-local-transport-user
N8N_BASIC_AUTH_PASS=replace-with-local-transport-password
