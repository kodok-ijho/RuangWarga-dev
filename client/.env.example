# Environment aplikasi: local, staging, atau production.
VITE_APP_ENV=local

# Aktifkan mode demo (preview UI tanpa backend production).
# Gunakan "false" untuk staging/production.
VITE_DEMO_MODE=true

# Browser lokal memakai proxy Vite agar Basic Auth gateway dan App JWT
# dapat diteruskan melalui header yang berbeda.
VITE_N8N_API_BASE_URL=/api/n8n
N8N_API_BASE_URL=https://api.example.com
N8N_BASIC_AUTH_USER=your-local-basic-auth-user
N8N_BASIC_AUTH_PASS=your-local-basic-auth-password

# Google OAuth Web Client ID. Public-safe untuk frontend.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Kredensial Supabase public. Dapatkan dari dashboard Supabase:
# Project Settings > API > Project URL dan anon public key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Web Push VAPID Public Key (opsional untuk push notification PWA)
VITE_VAPID_PUBLIC_KEY=
